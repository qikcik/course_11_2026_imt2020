+// ModifiedPduSession is one PDU session accepted in a PDU Session Resource Modify Request.
+type ModifiedPduSession = pdu_session_management.ModifiedPduSession
+
+func SendPduSessionResourceModifyResponse(sessions []ModifiedPduSession, ue *context.GNBUe) {
+	log.Info("[GNB] Initiating PDU Session Resource Modify Response")
+
+	ngapMsg, err := pdu_session_management.PDUSessionResourceModifyResponse(sessions, ue)
+	if err != nil {
+		log.Error("[GNB][NGAP] Error building PDU Session Resource Modify Response: ", err)
+		return
+	}
+
+	conn := ue.GetSCTP()
+	err = sender.SendToAmF(ngapMsg, conn)
+	if err != nil {
+		log.Error("[GNB][NGAP] Error sending PDU Session Resource Modify Response: ", err)
+	}
+}
