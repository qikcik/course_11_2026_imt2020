+// HandlerPduSessionResourceModifyRequest handles a network-initiated PDU session
+// modification (TS 38.413 8.2.3), for example a new GBR QoS flow for voice after
+// the PCF installs a new PCC rule. The simulated radio has no resources to
+// reserve, so every requested QoS flow is accepted: the gNB forwards the NAS
+// PDU Session Modification Command to the UE and answers with the QFIs it took.
+func HandlerPduSessionResourceModifyRequest(gnb *context.GNBContext, message *ngapmsg.PDUSessionResourceModifyRequest) {
+	var amfUeId int64
+	var ranUeId int64
+
+	if message.AMFUENGAPID != nil {
+		amfUeId = message.AMFUENGAPID.Value
+	}
+	if message.RANUENGAPID != nil {
+		ranUeId = message.RANUENGAPID.Value
+	}
+	if message.PDUSessionResourceModifyListModReq == nil {
+		log.Error("[GNB][NGAP] PDU Session Resource Modify Request is missing mandatory PDU SESSION RESOURCE MODIFY LIST MOD REQ")
+		return
+	}
+
+	ue := getUeFromContext(gnb, ranUeId, amfUeId)
+	if ue == nil {
+		log.Warn("[GNB][NGAP] Cannot modify PDU Session for unknown or terminated UE with RANUEID ", ranUeId, ", ignoring request")
+		return
+	}
+
+	var modified []trigger.ModifiedPduSession
+	for _, item := range message.PDUSessionResourceModifyListModReq.List {
+		if item.PDUSessionID == nil {
+			continue
+		}
+		pduSessionId := item.PDUSessionID.Value
+		pduSession, err := ue.GetPduSession(pduSessionId)
+		if err != nil || pduSession == nil {
+			log.Error("[GNB][NGAP] PDU Session ", pduSessionId, " to modify was not found, skipping")
+			continue
+		}
+
+		var qfis, released []int64
+		if item.PDUSessionResourceModifyRequestTransfer != nil {
+			transfer := &ngapType.PDUSessionResourceModifyRequestTransfer{}
+			if err := ngapConvert.Unmarshal(item.PDUSessionResourceModifyRequestTransfer, transfer); err != nil {
+				log.Error("[GNB][NGAP] Error in decode PDU Session Resource Modify Request Transfer: ", err)
+			} else if transfer.ProtocolIEs != nil {
+				for _, ies := range transfer.ProtocolIEs.List {
+					if ies.Id().Value == ngapType.ProtocolIEIDQosFlowToReleaseList && ies.QosFlowToReleaseList != nil {
+						for _, flow := range ies.QosFlowToReleaseList.List {
+							if flow.QosFlowIdentifier != nil {
+								released = append(released, flow.QosFlowIdentifier.Value)
+							}
+						}
+						continue
+					}
+					if ies.Id().Value != ngapType.ProtocolIEIDQosFlowAddOrModifyRequestList || ies.QosFlowAddOrModifyRequestList == nil {
+						continue
+					}
+					for _, flow := range ies.QosFlowAddOrModifyRequestList.List {
+						if flow.QosFlowIdentifier == nil {
+							continue
+						}
+						qfis = append(qfis, flow.QosFlowIdentifier.Value)
+						logModifiedQosFlow(pduSessionId, &flow)
+					}
+				}
+			}
+		}
+		pduSession.AddQosFlows(qfis)
+		pduSession.RemoveQosFlows(released)
+		log.Info("[GNB][NGAP][UE] PDU Session ", pduSessionId, " QoS flows: ", pduSession.GetQosFlows())
+		modified = append(modified, trigger.ModifiedPduSession{Id: pduSessionId, Qfis: qfis})
+
+		// The NAS PDU (PDU Session Modification Command) is optional in each item.
+		if item.NASPDU != nil {
+			sender.SendToUe(ue, item.NASPDU.Value)
+		}
+	}
+
+	if len(modified) == 0 {
+		log.Error("[GNB][NGAP] No PDU session could be modified for RAN UE ", ue.GetRanUeId(),
+			"; sending no Modify Response (failed-to-modify reporting is unimplemented)")
+		return
+	}
+	trigger.SendPduSessionResourceModifyResponse(modified, ue)
+}
+
+func logModifiedQosFlow(pduSessionId int64, flow *ngapType.QosFlowAddOrModifyRequestItem) {
+	log.Info("[GNB][NGAP][UE] PDU Session ", pduSessionId, ": add or modify QoS flow QFI ", flow.QosFlowIdentifier.Value)
+	params := flow.QosFlowLevelQosParameters
+	if params == nil {
+		return
+	}
+	if params.QosCharacteristics != nil {
+		switch descriptor := params.QosCharacteristics.Choice.(type) {
+		case *ngapType.NonDynamic5QIDescriptor:
+			if descriptor.FiveQI != nil {
+				log.Info("[GNB][NGAP][UE]   5QI: ", descriptor.FiveQI.Value)
+			}
+		case *ngapType.Dynamic5QIDescriptor:
+			if descriptor.FiveQI != nil {
+				log.Info("[GNB][NGAP][UE]   5QI (dynamic): ", descriptor.FiveQI.Value)
+			}
+		}
+	}
+	if params.AllocationAndRetentionPriority != nil && params.AllocationAndRetentionPriority.PriorityLevelARP != nil {
+		log.Info("[GNB][NGAP][UE]   Priority Level ARP: ", params.AllocationAndRetentionPriority.PriorityLevelARP.Value)
+	}
+	if gbr := params.GBRQosInformation; gbr != nil {
+		log.Info("[GNB][NGAP][UE]   GBR flow, MFBR DL/UL: ", bitRate(gbr.MaximumFlowBitRateDL), "/", bitRate(gbr.MaximumFlowBitRateUL),
+			" bit/s, GFBR DL/UL: ", bitRate(gbr.GuaranteedFlowBitRateDL), "/", bitRate(gbr.GuaranteedFlowBitRateUL), " bit/s")
+	}
+}
+
+func bitRate(rate *ngapType.BitRate) int64 {
+	if rate == nil {
+		return 0
+	}
+	return rate.Value
+}
