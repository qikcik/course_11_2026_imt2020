+/**
+ * SPDX-License-Identifier: Apache-2.0
+ * PDU Session Modification Complete (TS 24.501 8.3.10), for the training lab fork.
+ */
+package sm_5gs
+
+import nas "github.com/free5gc/nas/message"
+
+// GetPduSessionModificationComplete answers a PDU Session Modification Command.
+// The PTI repeats the one of the command: 0 for a network-initiated modification.
+func GetPduSessionModificationComplete(id uint8, pti uint8) []byte {
+	return encodePlain(&nas.PDUSessModComplete{PDUSessId: id, PTI: pti})
+}
