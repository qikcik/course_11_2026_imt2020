+// dnnForSession lets ue.dnn list several DNNs separated by commas: PDU session N
+// uses the Nth one, wrapping around. For example "ims,internet" with --nPdu 2
+// gives an IMS session (ID 1, the one with the tunnel) and an internet session (ID 2).
+func dnnForSession(dnns string, id uint8) string {
+	list := strings.Split(dnns, ",")
+	index := 0
+	if id > 0 {
+		index = (int(id) - 1) % len(list)
+	}
+	return strings.TrimSpace(list[index])
+}
