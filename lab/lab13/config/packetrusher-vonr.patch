+// GetQosFlows returns the QFIs of all accepted QoS flows, or the single
+// qosId when no list was recorded.
+func (pduSession *GnbPDUSession) GetQosFlows() []int64 {
+	pduSession.tunnelMu.RLock()
+	defer pduSession.tunnelMu.RUnlock()
+	if len(pduSession.qosFlows) == 0 {
+		return []int64{pduSession.qosId}
+	}
+	return append([]int64(nil), pduSession.qosFlows...)
+}
+
+// AddQosFlows records QoS flows set up or modified for the session.
+func (pduSession *GnbPDUSession) AddQosFlows(qfis []int64) {
+	pduSession.tunnelMu.Lock()
+	defer pduSession.tunnelMu.Unlock()
+	if len(pduSession.qosFlows) == 0 {
+		pduSession.qosFlows = []int64{pduSession.qosId}
+	}
+	for _, qfi := range qfis {
+		known := false
+		for _, existing := range pduSession.qosFlows {
+			known = known || existing == qfi
+		}
+		if !known {
+			pduSession.qosFlows = append(pduSession.qosFlows, qfi)
+		}
+	}
+}
+
+// RemoveQosFlows forgets QoS flows released from the session.
+func (pduSession *GnbPDUSession) RemoveQosFlows(qfis []int64) {
+	pduSession.tunnelMu.Lock()
+	defer pduSession.tunnelMu.Unlock()
+	kept := pduSession.qosFlows[:0]
+	for _, existing := range pduSession.qosFlows {
+		released := false
+		for _, qfi := range qfis {
+			released = released || existing == qfi
+		}
+		if !released {
+			kept = append(kept, existing)
+		}
+	}
+	pduSession.qosFlows = kept
+}
+
 func (pduSession *GnbPDUSession) GetFiveQI() int64 {
 	return pduSession.fiveQi
 }
